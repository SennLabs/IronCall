[
  { "name": "plain URL unchanged", "url": "https://api.example.com/users", "expected": "https://api.example.com/users" },
  { "name": "no path gets slash", "url": "https://api.example.com", "expected": "https://api.example.com/" },
  { "name": "trailing slash kept", "url": "https://api.example.com/users/", "expected": "https://api.example.com/users/" },
  { "name": "scheme lowercased", "url": "HTTPS://api.example.com/a", "expected": "https://api.example.com/a" },
  { "name": "http with port", "url": "http://localhost:8080/health", "expected": "http://localhost:8080/health" },
  { "name": "IPv6 host", "url": "http://[::1]:3000/x", "expected": "http://[::1]:3000/x" },
  { "name": "whitespace trimmed", "url": "  https://a.example/x  ", "expected": "https://a.example/x" },
  { "name": "fragment dropped", "url": "https://a.example/docs#section", "expected": "https://a.example/docs" },
  { "name": "space in path", "url": "https://a.example/my file", "expected": "https://a.example/my%20file" },
  { "name": "unicode in path", "url": "https://a.example/café", "expected": "https://a.example/caf%C3%A9" },
  { "name": "already encoded path not doubled", "url": "https://a.example/my%20file", "expected": "https://a.example/my%20file" },
  { "name": "lone percent encoded", "url": "https://a.example/100%", "expected": "https://a.example/100%25" },
  { "name": "pchar sub-delims kept", "url": "https://a.example/a;b=c,d@e:f", "expected": "https://a.example/a;b=c,d@e:f" },
  { "name": "query param appended", "url": "https://a.example/s", "params": [["q", "rust", true]], "expected": "https://a.example/s?q=rust" },
  { "name": "disabled param skipped", "url": "https://a.example/s", "params": [["q", "rust", true], ["debug", "1", false]], "expected": "https://a.example/s?q=rust" },
  { "name": "empty name skipped", "url": "https://a.example/s", "params": [["", "x", true], ["a", "1", true]], "expected": "https://a.example/s?a=1" },
  { "name": "empty value kept", "url": "https://a.example/s", "params": [["flag", "", true]], "expected": "https://a.example/s?flag=" },
  { "name": "space in query is %20", "url": "https://a.example/s", "params": [["q", "hello world", true]], "expected": "https://a.example/s?q=hello%20world" },
  { "name": "plus in query encoded", "url": "https://a.example/s", "params": [["tz", "+10:00", true]], "expected": "https://a.example/s?tz=%2B10:00" },
  { "name": "ampersand and equals encoded", "url": "https://a.example/s", "params": [["a&b", "c=d", true]], "expected": "https://a.example/s?a%26b=c%3Dd" },
  { "name": "hash in value encoded", "url": "https://a.example/s", "params": [["tag", "#rust", true]], "expected": "https://a.example/s?tag=%23rust" },
  { "name": "slash and question mark kept in query", "url": "https://a.example/s", "params": [["redirect", "/a/b?c", true]], "expected": "https://a.example/s?redirect=/a/b?c" },
  { "name": "already encoded query value", "url": "https://a.example/s", "params": [["q", "a%20b", true]], "expected": "https://a.example/s?q=a%20b" },
  { "name": "unicode query value", "url": "https://a.example/s", "params": [["city", "Zürich", true]], "expected": "https://a.example/s?city=Z%C3%BCrich" },
  { "name": "repeated names kept in order", "url": "https://a.example/s", "params": [["id", "1", true], ["id", "2", true]], "expected": "https://a.example/s?id=1&id=2" },
  { "name": "existing query kept then appended", "url": "https://a.example/s?x=1&y=two words", "params": [["z", "3", true]], "expected": "https://a.example/s?x=1&y=two%20words&z=3" },
  { "name": "existing empty query dropped", "url": "https://a.example/s?", "params": [["z", "3", true]], "expected": "https://a.example/s?z=3" },
  { "name": "query on root", "url": "https://a.example?x=1", "expected": "https://a.example/?x=1" },
  { "name": "colon path param substituted", "url": "https://a.example/users/:id", "pathParams": [["id", "42"]], "expected": "https://a.example/users/42" },
  { "name": "brace path param substituted", "url": "https://a.example/users/{id}/posts", "pathParams": [["id", "7"]], "expected": "https://a.example/users/7/posts" },
  { "name": "repeated path param", "url": "https://a.example/:org/x/:org", "pathParams": [["org", "acme"]], "expected": "https://a.example/acme/x/acme" },
  { "name": "path param value slash encoded", "url": "https://a.example/files/:path", "pathParams": [["path", "a/b c"]], "expected": "https://a.example/files/a%2Fb%20c" },
  { "name": "path param with query", "url": "https://a.example/users/:id", "pathParams": [["id", "5"]], "params": [["expand", "posts", true]], "expected": "https://a.example/users/5?expand=posts" },
  { "name": "missing path param value", "url": "https://a.example/users/:id", "pathParams": [["id", ""]], "error": "missingPathParam" },
  { "name": "undeclared path param", "url": "https://a.example/users/:id", "error": "missingPathParam" },
  { "name": "port colon is not a param", "url": "https://a.example:8443/x", "expected": "https://a.example:8443/x" },
  { "name": "colon inside segment is not a param", "url": "https://a.example/time/10:30", "expected": "https://a.example/time/10:30" },
  { "name": "variable braces kept in path", "url": "https://a.example/{{version}}/users", "expected": "https://a.example/{{version}}/users" },
  { "name": "variable braces kept in query", "url": "https://a.example/s", "params": [["key", "{{apiKey}}", true]], "expected": "https://a.example/s?key={{apiKey}}" },
  { "name": "raw mode leaves everything", "url": "https://a.example/my file", "params": [["q", "a b&c", true]], "encode": false, "expected": "https://a.example/my file?q=a b&c" },
  { "name": "raw mode path param", "url": "https://a.example/files/:p", "pathParams": [["p", "a/b"]], "encode": false, "expected": "https://a.example/files/a/b" },
  { "name": "empty URL", "url": "   ", "error": "empty" },
  { "name": "missing scheme", "url": "api.example.com/users", "error": "missingScheme" },
  { "name": "unsupported scheme", "url": "ftp://files.example.com/x", "error": "unsupportedScheme" },
  { "name": "missing host", "url": "https:///path", "error": "missingHost" },
  { "name": "invalid host", "url": "https://bad host/x", "error": "invalidHost" },
  { "name": "variable base URL", "url": "{{baseUrl}}/users", "error": "unresolvedVariable" },
  { "name": "variable host", "url": "https://{{host}}/users", "error": "unresolvedVariable" },
  { "name": "userinfo kept", "url": "https://user:pass@a.example/x", "expected": "https://user:pass@a.example/x" }
]
