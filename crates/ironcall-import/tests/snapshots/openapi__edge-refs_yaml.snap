      "url": "{{baseUrl}}/chained/:id",
      "pathParams": [
        {
          "name": "id",
          "value": "abc-123"
        }
      ]
    },
    {
      "kind": "request",
      "schema": "ironcall/request@1",
      "id": "01J00000000000000000000002",
      "name": "Parameter ref cycle",
      "method": "GET",
      "url": "{{baseUrl}}/cycle",
      "params": [
        {
          "name": "limit",
          "value": "25",
          "enabled": false
        }
      ]
    },
