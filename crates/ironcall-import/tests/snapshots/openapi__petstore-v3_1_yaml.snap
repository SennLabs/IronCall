source: tests/openapi.rs
expression: plan
---
{
  "version": "openApi31",
  "title": "Swagger Petstore",
  "description": null,
  "servers": [
    "https://petstore.example.com/v1"
  ],
  "environment": [
    {
      "name": "baseUrl",
      "value": "https://petstore.example.com/v1",
      "secret": false
    },
    {
      "name": "apiKey",
      "value": "",
      "secret": true
    }
  ],
  "rootAuth": {
    "type": "apiKey",
    "key": "X-Petstore-Key",
    "value": "{{apiKey}}",
    "in": "header"
  },
  "authSummary": [
    "petstoreKey → API key header `X-Petstore-Key: {{apiKey}}` on the collection"
  ],
  "tree": [
    {
      "kind": "folder",
      "name": "pets",
      "description": null,
      "items": [
        {
          "kind": "request",
          "schema": "ironcall/request@1",
          "id": "01J00000000000000000000001",
          "name": "List all pets",
          "description": "Operation `listPets`.",
          "method": "GET",
          "url": "{{baseUrl}}/pets",
          "params": [
            {
              "name": "limit",
              "value": "20",
              "enabled": false
            }
          ]
        },
        {
          "kind": "request",
          "schema": "ironcall/request@1",
          "id": "01J00000000000000000000002",
          "name": "Create a pet",
          "description": "Operation `createPets`.",
          "method": "POST",
          "url": "{{baseUrl}}/pets",
          "body": {
            "type": "json",
            "content": "{\n  \"id\": 10,\n  \"name\": \"doggie\",\n  \"tag\": \"dog\"\n}"
          }
        },
        {
          "kind": "request",
          "schema": "ironcall/request@1",
          "id": "01J00000000000000000000003",
          "name": "Info for a specific pet",
          "description": "Operation `showPetById`.",
          "method": "GET",
          "url": "{{baseUrl}}/pets/:petId",
          "pathParams": [
            {
              "name": "petId",
              "value": "42"
            }
          ],
          "auth": {
            "type": "none"
          }
        }
      ]
    }
  ],
  "warnings": [
    {
      "message": "webhooks aren't imported (they're requests the API sends, not ones you send)",
      "location": "#/webhooks"
    }
  ]
}
